# Copy to .env and fill in real values:
#   cp .env.example .env

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Set true to enable fake booking-flow helpers (dev only)
ENABLE_FAKE_FLOW=false

# ── Database (required) ─────────────────────────────────────────────────────
# Prisma / PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/homez?schema=public

# ── Auth / JWT (required) ───────────────────────────────────────────────────
JWT_SECRET=change-me-customer-jwt-secret
JWT_EXPIRES_IN=7d

STAFF_JWT_SECRET=change-me-staff-jwt-secret
STAFF_JWT_EXPIRES_IN=7d

ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=7d

# Used to hash OTPs (required for login/OTP flows)
OTP_HASH_SECRET=change-me-otp-hash-secret

# ── Admin seed (optional; used by prisma seed) ──────────────────────────────
ADMIN_SEED_EMAIL=homez@gmail.com
ADMIN_SEED_PASSWORD=homez123

# ── Twilio SMS (required in production; skipped in development) ─────────────
# In development, OTP is always 123456 and SMS is not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Razorpay (required for payments) ───────────────────────────────────────
RAZORPAY_KEY=rzp_test_xxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret
# Optional; falls back to RAZORPAY_SECRET if unset
RAZORPAY_WEBHOOK_SECRET=

# ── AWS S3 (required for file uploads) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=homezy-526123657630-eu-north-1-an
# public-read | none — object ACL on upload. Bucket must allow ACLs, OR use a
# bucket policy for s3:GetObject (Block Public Access must allow the policy).
AWS_S3_OBJECT_ACL=public-read

# ── Business / dispatch (optional; defaults shown) ──────────────────────────
PLATFORM_FEE_INR=20
DISPATCH_OFFER_WINDOW_SEC=60
DISPATCH_RADIUS_TIERS=1,2,5
DISPATCH_STAFF_STALE_SEC=120
DISPATCH_SWEEP_MS=5000
BOOKING_FLOW_TICK_MS=10000
SSE_HEARTBEAT_MS=15000
